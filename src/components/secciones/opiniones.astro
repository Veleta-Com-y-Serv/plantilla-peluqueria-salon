---
// Opiniones sobre banda rosa: la primera opinión como cita enorme en serif cursiva, centrada, con comillas doradas;
// las demás debajo, en dos o tres columnas separadas por filetes. `testimonios: [{texto, autor, nota}]`
// (`nota` = el servicio que se hizo). Sin opiniones, no se pinta nada más que el titular.
import { seccion } from '../../data/site';
import Titular from '../ui/Titular.astro';
interface Props { id: string }
const s = seccion(Astro.props.id);
const lista = s ? s.testimonios.filter((t) => t && t.texto) : [];
const [primera, ...resto] = lista;
---

{
  s && (
    <section id={Astro.props.id} class="seccion banda-rosa">
      <div class="contenedor">
        <Titular antetitulo={s.antetitulo} titulo={s.titulo} texto={s.texto} alinear="centro" />
        {primera && (
          <figure class="cita-grande">
            <span class="cita-comillas" aria-hidden="true">“</span>
            <blockquote><p>{primera.texto}</p></blockquote>
            <figcaption class="etiqueta-mayus mt-8">{primera.autor}{primera.nota && <span class="opacity-70"> · {primera.nota}</span>}</figcaption>
          </figure>
        )}
        {resto.length > 0 && (
          <ul class="opiniones-resto">
            {resto.map((t) => (
              <li class="opinion">
                <p class="opinion-texto">«{t.texto}»</p>
                <p class="etiqueta-mayus mt-5">{t.autor}{t.nota && <span class="opacity-70"> · {t.nota}</span>}</p>
              </li>
            ))}
          </ul>
        )}
      </div>
    </section>
  )
}

<style>
  .cita-grande { max-width: 70rem; margin-inline: auto; text-align: center; }
  .cita-comillas { display: block; height: 4.5rem; font-family: var(--fuente-titulos); font-size: 9rem; line-height: 1; color: var(--resalte); }
  .cita-grande blockquote { font-family: var(--fuente-titulos); font-style: italic; font-size: clamp(1.75rem, 4.2vw, 3.6rem); line-height: 1.15; letter-spacing: -0.01em; }
  .opiniones-resto { display: grid; gap: 2.5rem; margin-top: 4.5rem; padding-top: 3rem; border-top: 1px solid color-mix(in srgb, currentColor 30%, transparent); }
  @media (min-width: 768px) { .opiniones-resto { grid-template-columns: repeat(auto-fit, minmax(20rem, 1fr)); gap: 4rem; } }
  .opinion-texto { font-family: var(--fuente-titulos); font-size: 1.4rem; line-height: 1.35; }
</style>
