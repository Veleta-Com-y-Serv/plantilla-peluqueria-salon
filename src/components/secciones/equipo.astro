---
// Equipo sobre banda negra: titular a la izquierda y texto a la derecha; debajo, retratos 3:4 en rejilla de hasta
// cuatro columnas en zigzag (las pares bajan un escalón en escritorio), con el marco dorado fino y un velo rosa.
// `personas: [{nombre, cargo, especialidad, foto, texto}]`; `especialidad` es una cadena (con comas si son varias).
// Sin foto, una silueta (/placeholders/persona.svg). Sin personas, no se pinta la rejilla.
import { seccion } from '../../data/site';
import Imagen from '../ui/Imagen.astro';
import Titular from '../ui/Titular.astro';
interface Props { id: string }
const s = seccion(Astro.props.id);
const personas = s ? s.personas.filter((p) => p && p.nombre) : [];
---

{
  s && (
    <section id={Astro.props.id} class="seccion banda-negra">
      <div class="contenedor">
        <div class="grid gap-6 lg:grid-cols-[minmax(0,1.4fr)_minmax(0,1fr)] lg:items-end lg:gap-16">
          <Titular antetitulo={s.antetitulo} titulo={s.titulo} class="!mb-0" />
          {s.texto && <p class="titular-texto lg:!mt-0">{s.texto}</p>}
        </div>
        {personas.length > 0 && (
          <ul class="equipo-rejilla">
            {personas.map((p) => (
              <li class="persona">
                <div class="persona-foto marco">
                  <Imagen src={p.foto || '/placeholders/persona.svg'} alt={p.nombre} ancho={600} alto={800} class="h-full w-full object-cover" />
                </div>
                {p.cargo && <p class="etiqueta-mayus resalte mt-5">{p.cargo}</p>}
                <h3 class="persona-nombre">{p.nombre}</h3>
                {p.especialidad && <p class="persona-especialidad">{p.especialidad}</p>}
                {p.texto && <p class="mt-3 text-[.95rem] opacity-75">{p.texto}</p>}
              </li>
            ))}
          </ul>
        )}
      </div>
    </section>
  )
}

<style>
  /* En móvil, dos columnas en zigzag (la segunda baja medio retrato) para que no sea una tira interminable */
  .equipo-rejilla { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 2.5rem 1rem; margin-top: 3rem; }
  .persona:nth-child(even) { transform: translateY(2.5rem); }
  .equipo-rejilla:has(> .persona:nth-child(2)) { padding-bottom: 2.5rem; }
  .persona:only-child { grid-column: 1 / -1; max-width: 22rem; }
  @media (min-width: 640px) { .equipo-rejilla { gap: 3rem 1.5rem; } }
  @media (min-width: 1024px) {
    .equipo-rejilla { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 2.25rem; margin-top: 4.5rem; padding-bottom: 4rem; }
    .persona:nth-child(even) { transform: translateY(4rem); }
  }
  .persona-foto { aspect-ratio: 3 / 4; background: color-mix(in srgb, var(--c-primario) 18%, var(--c-fondo)); }
  .persona-foto::before { content: ""; position: absolute; inset: 0; z-index: 1; background: color-mix(in srgb, var(--c-primario) 22%, transparent); mix-blend-mode: soft-light; pointer-events: none; }
  .persona-foto :global(img) { filter: grayscale(.25) contrast(1.03); }
  .persona-nombre { margin-top: .5rem; font-size: clamp(1.35rem, 2.4vw, 2.2rem); line-height: 1.05; }
  .persona-especialidad { margin-top: .5rem; font-family: var(--fuente-titulos); font-style: italic; font-size: 1rem; line-height: 1.3; color: var(--c-primario); }
  .persona :global(.etiqueta-mayus) { font-size: .62rem; letter-spacing: .2em; }
  @media (max-width: 639px) { .persona-foto.marco::after { inset: .5rem; } .persona > p:last-child:not(.persona-especialidad) { font-size: .88rem; } }
  @media (min-width: 640px) { .persona-especialidad { font-size: 1.1rem; } .persona :global(.etiqueta-mayus) { font-size: .7rem; letter-spacing: .28em; } }
</style>
