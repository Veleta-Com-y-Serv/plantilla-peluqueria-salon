---
// Apartado de texto genérico (apartados nuevos del cliente: `tipo: texto`). Banda negra de borde a borde:
// antetítulo, título en serif fina (segunda parte en cursiva), párrafos (`texto`, separados por línea en blanco),
// `items: [{titulo, texto, icono}]` en columnas y `cta`. Con `imagen`, fila 50/50 con la foto a sangre hasta el borde
// izquierdo de la ventana y el marco dorado.
import { seccion, parrafos } from '../../data/site';
import { altSeccion } from '../../lib/seo';
import Imagen from '../ui/Imagen.astro';
import Icono from '../ui/Icono.astro';
import Cursiva from '../ui/Cursiva.astro';
interface Props { id: string }
const s = seccion(Astro.props.id);
---

{
  s && (
    <section id={Astro.props.id} class:list={['apartado banda-negra', { 'apartado--foto': !!s.imagen }]}>
      {s.imagen && (
        <div class="apartado-foto marco">
          <Imagen src={s.imagen} alt={altSeccion(s)} ancho={1200} alto={900} class="h-full w-full object-cover" />
        </div>
      )}
      <div class="apartado-cuerpo">
        {s.antetitulo && <p class="antetitulo">{s.antetitulo}</p>}
        {s.titulo && <h2 class="titulo-seccion"><Cursiva texto={s.titulo} /></h2>}
        {parrafos(s.texto).length > 0 && <div class="mt-7 max-w-3xl space-y-4 text-lg opacity-85">{parrafos(s.texto).map((p) => <p>{p}</p>)}</div>}
        {s.items.length > 0 && (
          <ul class="mt-10 grid gap-8 sm:grid-cols-2">
            {s.items.map((it) => (
              <li class="border-t border-[var(--resalte)] pt-5">
                <Icono nombre={it.icono} class="resalte" tam={22} />
                <p class="mt-3 font-display text-2xl">{it.titulo}</p>
                {it.texto && <p class="mt-1 text-[.95rem] opacity-75">{it.texto}</p>}
              </li>
            ))}
          </ul>
        )}
        {s.cta?.url && <p class="mt-10"><a class="btn" href={s.cta.url}>{s.cta.texto}</a></p>}
      </div>
    </section>
  )
}

<style>
  .apartado { display: grid; grid-template-columns: minmax(0, 1fr); }
  .apartado-cuerpo { width: 100%; max-width: var(--ancho); margin-inline: auto; padding: var(--ritmo) 1rem; }
  .apartado-foto { height: 66vw; max-height: 30rem; }
  @media (min-width: 768px) { .apartado-cuerpo { padding: var(--ritmo-md) 2rem; } }
  @media (min-width: 1024px) {
    .apartado--foto { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }
    .apartado--foto .apartado-cuerpo { max-width: none; margin: 0; padding-left: 4.5rem; padding-right: max(2rem, calc((100vw - var(--ancho)) / 2 + 2rem)); }
    .apartado-foto { height: auto; max-height: none; min-height: 32rem; }
  }
</style>
