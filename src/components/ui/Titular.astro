---
// Titular de sección: antetítulo en mayúsculas con filete dorado + título en serif fina enorme (la segunda parte
// en cursiva, ver Cursiva.astro) + texto. Adaptado de AstroWind (Headline.astro), © onWidget, MIT.
import Cursiva from './Cursiva.astro';
interface Props { titulo?: string; antetitulo?: string; texto?: string; alinear?: 'izquierda' | 'centro'; class?: string; nivel?: 1 | 2 }
const { titulo, antetitulo, texto, alinear = 'izquierda', class: clase = '', nivel = 2 } = Astro.props;
const H = nivel === 1 ? 'h1' : 'h2';
---

{
  (titulo || antetitulo || texto) && (
    <div class:list={['titular', { 'titular--centro': alinear === 'centro' }, clase]}>
      {antetitulo && <p class="antetitulo">{antetitulo}</p>}
      {titulo && <H class="titulo-seccion"><Cursiva texto={titulo} /></H>}
      {texto && <p class="titular-texto">{texto}</p>}
    </div>
  )
}
